# ---------------------------------------------------------------------------
# Boosta mobile environment variables.
# Copy this file to `.env` and fill in values for local development.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to app code, and
# these are public: the anon key is safe to ship in a mobile build.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
