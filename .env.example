# ---------------------------------------------------------------------------
# Boosta environment variables
# Copy this file to `.env.local` and fill in values for local development.
# All variables are validated at build/boot time in `src/lib/env.ts`.
# ---------------------------------------------------------------------------

# Public application metadata (exposed to the browser).
NEXT_PUBLIC_APP_NAME="Boosta"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Auth + Database). Find these in your Supabase project settings.
# The URL and anon key are public; the service-role key is SECRET and
# server-only — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Set to "true" to skip environment validation (e.g. in some CI steps).
# Never enable this in application runtime.
# SKIP_ENV_VALIDATION="false"
